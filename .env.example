# Copy this file to .env and fill in real values. .env is git-ignored.
# Never commit .env and never paste the key in chat.
# Create a free account + key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here

# Any current ':free' model id from https://openrouter.ai/models (filter: pricing = free)
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
